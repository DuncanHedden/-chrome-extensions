{
  "name": "@threadline/core",
  "version": "1.0.0",
  "private": true,
  "description": "Product-agnostic delivery pipeline: Google Chat destinations, rate limiting, retries, delivery log, storage interfaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/index.js"
  }
}
